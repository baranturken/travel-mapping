# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Geoapify Static Maps key — used for the basemap in photo story templates.
# Get one at https://myprojects.geoapify.com. Before launch, restrict the key
# by allowed referrer/domain and set a usage cap in the Geoapify dashboard.
EXPO_PUBLIC_GEOAPIFY_KEY=your-geoapify-key-here

# Cloudflare Turnstile site key — public by design (it is embedded in the
# widget HTML and ships in the bundle). Create a widget at Cloudflare → Turnstile
# with your app's hostname registered.
#
# The matching SECRET key is NOT stored in this repo. It goes only into
# Supabase → Authentication → Attack Protection, which is where tokens are
# verified server-side.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
